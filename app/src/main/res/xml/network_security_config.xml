<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext ws:// to the PC on the local network.
  If you later use wss:// (TLS), you can drop the cleartext flag.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
